# Single-page app routing + caching for Apache shared hosting.
# Adjust RewriteBase if the app is deployed in a subdirectory.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # API traffic goes to the backend front controller (api.php -> backend/public).
    RewriteRule ^api(/.*)?$ /api.php [L,QSA]

    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Never serve SQL dumps, docs or logs.
<FilesMatch "\.(sql|md|log|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # Fingerprinted assets can be cached aggressively.
    <FilesMatch "\.(js|css|woff2?|png|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Never cache the service worker or the app shell entry point.
    # This block must stay last: it overrides the immutable rule for sw.js.
    <FilesMatch "(^sw\.js$|^index\.html$|^manifest\.webmanifest$)">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
