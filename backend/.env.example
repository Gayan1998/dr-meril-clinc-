# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost/dr_meril/backend/public

# Comma separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dr_meril_clinic
DB_USER=root
DB_PASS=

# ---- Auth ----
# Session lifetime for bearer tokens (minutes). Default 12 hours.
AUTH_TOKEN_TTL_MINUTES=720

# ---- Security ----
# Max failed login attempts per username+IP before temporary lock (minutes)
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=10
