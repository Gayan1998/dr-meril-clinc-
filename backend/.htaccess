# Protect application source, configuration and dotfiles from direct web access.
# Only backend/public/ is meant to be reachable. In production, point the
# document root at backend/public and this file becomes a second line of defence.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|core|helpers|api|database)/ - [F,L]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|md|log|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
