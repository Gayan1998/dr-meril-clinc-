# Production environment. Copy this file to backend/.env ON THE SERVER and
# fill in the real values. Never commit backend/.env.
#
#   cp backend/.env.production.example backend/.env

# ---- Application ----
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo
APP_URL=https://c1.luxoraskinclinic.com

# Frontend origin(s) allowed to call the API. Leave empty when the frontend
# is served from the same origin as the API (recommended).
CORS_ALLOWED_ORIGINS=

# ---- Database ----
# Use a dedicated MySQL user with access to only this database.
# Never use root and never leave the password empty in production.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=luxoraskin_c1
DB_USER=luxoraskin_admin
DB_PASS=change-me

# ---- Auth ----
# Session lifetime for bearer tokens (minutes). Default 12 hours.
AUTH_TOKEN_TTL_MINUTES=720

# ---- Security ----
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=10
